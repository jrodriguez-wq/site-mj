{
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Bash(npm *)",
      "Bash(git *)",
      "Bash(pnpm *)",
      "Bash(node *)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; if [[ \"$f\" == *.md ]]; then echo \"✓ Markdown created: $(basename \\\"$f\\\")\"; fi; } 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "autoMemoryEnabled": true
}
